{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codice-api",
  "account_id": "473fbe436e39d8f3d33b6bb09afd3dd7",
  "main": "src/index.ts",
  "minify": true,
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  // No route of its own: `codice.io` belongs to `codice-edge`, which forwards `/v1`, `/mcp`,
  // `/health` and `/ready` here. See SPEC.md, "Go-live checklist".
  "workers_dev": false,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "secrets": {
    "required": ["ANTHROPIC_API_KEY", "SENTRY_DSN"],
  },
  // Hybrid search over the corpus passages (built-in storage). Instance settings: SPEC.md, "Search".
  // AI Search does not run locally, so `wrangler dev` reaches the real instance.
  "ai_search": [
    {
      "binding": "CODICE_SEARCH",
      "instance_name": "codice",
      "remote": true,
    },
  ],
  // Structured records: CFDI error codes and SAT catalogs. Schema: src/db/schema.ts.
  "d1_databases": [
    {
      "binding": "CODICE_DATABASE",
      "database_name": "codice",
      "database_id": "71e6503f-0e57-4349-b37f-53aa545d90b1",
      "migrations_dir": "migrations",
    },
  ],
  // API keys: `/v1` and `/mcp` verify the caller's key with `codice-app`. SPEC.md, "Auth".
  "services": [{ "binding": "ACCOUNTS", "service": "codice-app", "entrypoint": "CodiceAccounts" }],
  // Per-key limit for `/v1` and `/mcp`. SPEC.md, "Rate limiting".
  "ratelimits": [
    {
      "name": "CODICE_PUBLIC_RATE_LIMITER",
      "namespace_id": "1601",
      "simple": { "limit": 60, "period": 60 },
    },
    // Per-client limit for the demo chat, `POST /v1/chat`. SPEC.md, "Chat".
    {
      "name": "CODICE_CHAT_RATE_LIMITER",
      "namespace_id": "1602",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "upload_source_maps": true,
}
