{
  "name": "@codice/edge",
  "private": true,
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy:production": "wrangler deploy --tag $WORKERS_CI_COMMIT_SHA",
    "test": "vitest run --config ../../vitest.node.config.mts",
    "check-types": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@codice/typescript-config": "workspace:*",
    "@types/node": "^24.13.3",
    "typescript": "7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.1"
  }
}
