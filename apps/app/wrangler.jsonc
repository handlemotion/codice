{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codice-app",
  "account_id": "473fbe436e39d8f3d33b6bb09afd3dd7",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // Reached through the `APP` service binding of `codice-edge`; `dashboard.codice.io` is added as a
  // custom domain once the zone is in the account (apps/edge/AGENTS.md, "Domains").
  "workers_dev": false,
  "preview_urls": false,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 },
  },
}
