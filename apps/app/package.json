{
  "name": "@codice/app",
  "private": true,
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "dev": "MINIFLARE_REGISTRY_PATH=../../.wrangler/registry vite dev",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "deploy:production": "pnpm run db:migrate:remote && wrangler deploy --tag $WORKERS_CI_COMMIT_SHA",
    "preview": "vite preview",
    "check-types": "tsc -b --pretty false",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply ACCOUNTS_DATABASE --local",
    "db:migrate:remote": "wrangler d1 migrations apply ACCOUNTS_DATABASE --remote",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.14",
    "@better-auth/core": "1.7.14",
    "@codice/contracts": "workspace:*",
    "@tanstack/react-router": "1.170.31",
    "@tanstack/react-start": "1.168.48",
    "better-auth": "1.7.14",
    "drizzle-orm": "^0.45.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@codice/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "1.167.32",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.1"
  }
}
