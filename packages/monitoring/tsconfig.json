{
  "extends": "@codice/typescript-config/base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "rootDir": "src",
    "outDir": ".tsbuild",
    "tsBuildInfoFile": ".tsbuild/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": [".tsbuild", "node_modules", "src/**/*.test.ts"]
}
